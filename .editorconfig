# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.md]
indent_size = 2
# trailing whitespace is significant in Markdown (two spaces = hard line break)
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2
