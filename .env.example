# Optional single Ollama embedding endpoint.
OLLAMA_HOST=http://localhost:11434
# Optional comma-separated pool; url=weight is supported and overrides OLLAMA_HOST.
# OLLAMA_HOSTS=http://localhost:11434=1
# Embedding model; a missing model may be pulled by the optional client integration.
DISTILL_EMBED_MODEL=mxbai-embed-large
# This file documents settings; the CLI does not load .env files automatically.
