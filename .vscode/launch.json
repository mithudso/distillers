{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mirror statistics",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/distill_offline.py",
      "args": ["mirror", "--in", "${input:mirrorPath}"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {"id": "mirrorPath", "type": "promptString", "description": "Path to a known local mirror"}
  ]
}
